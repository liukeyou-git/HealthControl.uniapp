/* 水平间距 */
.sport-list-container.data-v-e9ac9fcf {
  height: 100vh;
  width: 100vw;
  /* 限制容器宽度 */
  overflow-x: hidden;
  /* 禁止横向滚动 */
  background: linear-gradient(135deg, #e8f5e8 0%, #f0f8f0 100%);
  box-sizing: border-box;
  /* 包含边距在宽度计算内 */
}

/* 主要内容区域 */
.content-wrapper.data-v-e9ac9fcf {
  height: calc(100vh - 44px);
  width: 100vw;
  /* 限制宽度为视窗宽度 */
  overflow-x: hidden;
  /* 禁止横向滚动 */
}

/* 运动内容 */
.sport-content.data-v-e9ac9fcf {
  height: 100%;
  width: 100%;
  /* 确保宽度不超出父容器 */
  box-sizing: border-box;
  /* 包含padding在宽度计算内 */
}
.sport-content .sport-scroll.data-v-e9ac9fcf {
  height: 100%;
  width: 100%;
  padding: 20rpx;
  box-sizing: border-box;
  /* 包含padding在宽度计算内 */
}

/* 运动列表 */
.sport-list.data-v-e9ac9fcf {
  background: linear-gradient(135deg, #ffffff 0%, #fafffe 100%);
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(76, 175, 80, 0.1);
  border: 1rpx solid rgba(76, 175, 80, 0.1);
  width: 100%;
  /* 确保不超出父容器 */
  box-sizing: border-box;
  /* 包含边框在宽度计算内 */
}

/* 运动项 */
.sport-item.data-v-e9ac9fcf {
  display: flex;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
