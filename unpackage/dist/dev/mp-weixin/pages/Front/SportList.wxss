  /* 包含padding在宽度计算内 */
  overflow: hidden;
  /* 防止内容溢出 */
}
.sport-item.data-v-e9ac9fcf:last-child {
  border-bottom: none;
}
.sport-item.data-v-e9ac9fcf:active {
  background: linear-gradient(135deg, #f0f8f0 0%, #e8f5e8 100%);
