/* 页面容器 */
.page-container.data-v-b146bd57 {
  min-height: 100vh;
  background: linear-gradient(135deg, #f8fffe 0%, #ecfdf5 100%);
}

/* 内容包装器 */
.content-wrapper.data-v-b146bd57 {
  padding: 20rpx;
  padding-bottom: 140rpx;
  /* 给底部导航留出空间 */
}

/* 欢迎横幅 */
.welcome-banner.data-v-b146bd57 {
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-light) 100%);
  border-radius: var(--border-radius-lg);
  margin-bottom: var(--spacing-base);
  box-shadow: var(--box-shadow-base);
}
.banner-content.data-v-b146bd57 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-lg);
}
.welcome-info.data-v-b146bd57 {
  display: flex;
  flex-direction: column;
}
.welcome-title.data-v-b146bd57 {
  color: white;
  font-size: var(--font-size-lg);
  font-weight: 600;
  margin-bottom: var(--spacing-xs);
}
.welcome-subtitle.data-v-b146bd57 {
  color: rgba(255, 255, 255, 0.9);
  font-size: var(--font-size-base);
}
.health-icon .icon.data-v-b146bd57 {
  font-size: 60rpx;
}

/* 健康概览 */
.health-overview.data-v-b146bd57 {
  margin-bottom: var(--spacing-base);
}
.section-title.data-v-b146bd57 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-base);
  padding: 0 var(--spacing-xs);
}
.title-text.data-v-b146bd57 {
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--text-color);
}
.more-text.data-v-b146bd57 {
  font-size: var(--font-size-sm);
  color: var(--primary-color);
}
.overview-cards.data-v-b146bd57 {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--spacing-base);
}
.overview-card.data-v-b146bd57 {
  background: white;
  border-radius: var(--border-radius-base);
  padding: var(--spacing-base);
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: var(--box-shadow-sm);
  transition: var(--transition-base);
}
.overview-card.data-v-b146bd57:active {
  transform: scale(0.98);
}
.card-icon.data-v-b146bd57 {
  font-size: 48rpx;
  margin-bottom: var(--spacing-xs);
}
.card-label.data-v-b146bd57 {
  font-size: var(--font-size-sm);
  color: var(--text-color-light);
  margin-bottom: var(--spacing-xs);
}
.card-value.data-v-b146bd57 {
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: var(--text-color);
  margin-bottom: 4rpx;
}
.card-unit.data-v-b146bd57 {
  font-size: var(--font-size-xs);
  color: var(--text-color-lighter);
}

/* 快捷功能 */
.quick-actions.data-v-b146bd57 {
  margin-bottom: var(--spacing-base);
}
.action-grid.data-v-b146bd57 {
  background: white;
  border-radius: var(--border-radius-base);
  padding: var(--spacing-base);
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--spacing-lg);
  box-shadow: var(--box-shadow-sm);
}
.action-item.data-v-b146bd57 {
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: var(--transition-base);
}
.action-item.data-v-b146bd57:active {
  transform: scale(0.95);
}
.action-icon.data-v-b146bd57 {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--border-radius-circle);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-bottom: var(--spacing-xs);
  background: var(--bg-color-light);
}
.action-label.data-v-b146bd57 {
  font-size: var(--font-size-sm);
  color: var(--text-color);
  text-align: center;
}

/* 健康资讯 */
.health-news.data-v-b146bd57 {
  margin-bottom: var(--spacing-base);
}
.news-list.data-v-b146bd57 {
  background: white;
  border-radius: var(--border-radius-base);
  overflow: hidden;
  box-shadow: var(--box-shadow-sm);
}
.news-item.data-v-b146bd57 {
  display: flex;
  padding: var(--spacing-base);
  border-bottom: 1rpx solid var(--border-color-light);
  transition: var(--transition-base);
}
.news-item.data-v-b146bd57:last-child {
  border-bottom: none;
}
.news-item.data-v-b146bd57:active {
  background-color: var(--bg-color-hover);
}
.news-content.data-v-b146bd57 {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-right: var(--spacing-base);
}
.news-title.data-v-b146bd57 {
  font-size: var(--font-size-base);
  color: var(--text-color);
  font-weight: 500;
  margin-bottom: var(--spacing-xs);
}
.news-desc.data-v-b146bd57 {
  font-size: var(--font-size-sm);
  color: var(--text-color-light);
  margin-bottom: var(--spacing-xs);
  line-height: 1.4;
}
.news-time.data-v-b146bd57 {
  font-size: var(--font-size-xs);
  color: var(--text-color-lighter);
}
.news-image.data-v-b146bd57 {
  width: 120rpx;
  height: 80rpx;
  border-radius: var(--border-radius-sm);
  background: var(--bg-color-light);
  display: flex;
  align-items: center;
  justify-content: center;
}
.placeholder-icon.data-v-b146bd57 {
  font-size: 40rpx;
}